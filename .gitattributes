# Normalise line endings on commit so Windows contributors don't introduce CRLF churn.
# Checkout uses the platform default; the repository always stores LF.
* text=auto eol=lf

# Explicitly binary — never attempt to diff or convert these
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.bmp binary
*.tiff binary
*.ico binary
*.pdf binary
*.npz binary
*.npy binary

# Generated / vendored
dist/** linguist-generated=true
